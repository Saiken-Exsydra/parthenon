---
import { business, bookingServices, calendarBooking, serviceGroups, whatsappUrl } from '../data/business';

const { email: EMAIL, instagramUrl: INSTAGRAM_URL, owner: OWNER, whatsappDisplay: WHATSAPP_TEL } = business;
const WHATSAPP_URL = whatsappUrl;
const HERO_PANEL_ENABLED = false;
const servicesByGroup = serviceGroups.map(group => ({
  ...group,
  services: group.serviceIds
    .map(serviceId => bookingServices.find(service => service.id === serviceId))
    .filter(Boolean),
}));
const calendarServices = bookingServices.filter(service => service.bookingMode === 'calendar');

const hours = [
  { day: 'Segunda-feira', value: '10h às 19h' },
  { day: 'Terça-feira', value: '10h às 20h' },
  { day: 'Quarta-feira', value: '10h às 20h' },
  { day: 'Quinta-feira', value: '10h às 18h' },
  { day: 'Sexta-feira', value: '12h às 18h' },
  { day: 'Sábado', value: '10h às 17h' },
];

const gallery = [
  '/uploads/2020-08-04.jpg',
  '/uploads/2020-08-04s.jpg',
  '/uploads/2020-08-0d4.jpg',
  '/uploads/2020-08dd-04.jpg',
  '/uploads/B271D041-2BA0-473C-9174-6C53C7003BF3.jpeg',
  '/uploads/B9B906E5-0986-4986-AFED-77EC5CA97CE6.jpeg',
];
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="Parthenon Barbearia — cortes, barba, sobrancelha, pezinho e tratamentos capilares em Uberlândia, MG. Agende com Marco Antônio pelo WhatsApp." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Parthenon Barbearia — Uberlândia, MG</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=Playfair+Display:wght@400;700;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #020202;
      --surface: #0a0f17;
      --surface-soft: rgba(8, 13, 22, 0.78);
      --ink: #ffffff;
      --muted: rgba(255, 255, 255, 0.62);
      --line: rgba(255, 255, 255, 0.11);
      --accent: #9a1f3d;
      --navy: #182866;
      --radius: 12px;
      --section-space: 4.5rem;
      --hero-card-shadow-alpha: 0.52;
      --hero-bg-y-offset: 56px;
      --font-display: "Playfair Display", Georgia, serif;
      --font-body: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #030303;
      color: var(--ink);
      font-family: var(--font-body);
      line-height: 1.65;
      min-width: 320px;
    }

    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; }

    .shell {
      background: #030303;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.8rem 1rem;
      background: rgba(255, 255, 255, 0.94);
      border-bottom: 1px solid rgba(13, 27, 42, 0.08);
      backdrop-filter: blur(10px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .brand img {
      width: 52px;
      mix-blend-mode: normal;
    }

    .brand-copy {
      display: grid;
      gap: 0.1rem;
    }

    .brand-copy small {
      font-size: 0.68rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(13, 27, 42, 0.52);
    }

    .brand-copy strong {
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 0.06em;
      font-weight: 900;
      color: #0d1b2a;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0.55rem 0.72rem;
      border: 1px solid rgba(13, 27, 42, 0.16);
      border-radius: var(--radius);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
      color: #0d1b2a;
      transition: background 160ms ease, border-color 160ms ease;
    }

    .nav-link:hover { border-color: #1a3a5c; background: rgba(26, 58, 92, 0.06); }
    .nav-link__mobile { display: inline; }
    .nav-link__desktop { display: none; }

    :global(body.is-booking) .nav { display: none; }
    :global(body.is-booking) .section-booking { min-height: 100dvh; }

    .hero {
      position: relative;
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: 5.5rem 1rem 2rem;
      background-color: #000;
      background-image: url("/uploads/wood.png");
      background-repeat: repeat;
      background-position: left var(--hero-bg-y-offset);
      background-size: 720px auto;
      overflow: clip;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.2);
    }

    .hero-card {
      position: relative;
      z-index: 1;
      width: min(100%, 33rem);
      text-align: center;
      padding: 2rem 1.25rem 2.2rem;
    }

    .hero-card--panel {
      background: rgba(0, 0, 0, 0.62);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      box-shadow: 0 0 90px 48px rgba(0, 0, 0, var(--hero-card-shadow-alpha));
    }

    .hero-card--plain {
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .hero-logo {
      width: min(72vw, 220px);
      margin: 0 auto 1.75rem;
      mix-blend-mode: screen;
      filter: saturate(1.35) contrast(1.18) brightness(1.14);
    }

    .hero-quote {
      margin: 0 0 0.85rem;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.7rem, 6vw, 2.5rem);
      line-height: 1.25;
    }

    .hero-byline {
      margin: 0 0 1.75rem;
      font-size: 0.72rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
    }

    .hero-actions {
      display: grid;
      gap: 0.75rem;
    }

    .cta,
    .cta-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0.95rem 1.2rem;
      border-radius: var(--radius);
      font-size: 0.78rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .cta {
      border: 1px solid rgba(255, 255, 255, 0.56);
      background: transparent;
      color: #fff;
    }

    .cta-secondary {
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(255, 255, 255, 0.82);
    }

    .scroll-note {
      position: absolute;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
      display: grid;
      justify-items: center;
      gap: 0.25rem;
      font-size: 0.64rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.34);
    }

    .container {
      width: min(100% - 2rem, 68rem);
      margin: 0 auto;
    }

    section:not(.hero) {
      padding: var(--section-space) 0;
    }

    .section-light {
      background: #f4f7fa;
      color: #1a1a2e;
    }

    .section-white {
      background: #ffffff;
      color: #1a1a2e;
    }

    .section-head {
      margin-bottom: 2rem;
    }

    .section-head small {
      display: block;
      margin-bottom: 0.65rem;
      font-size: 0.72rem;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: #5a6a7a;
    }

    .section-head h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2rem, 7vw, 3rem);
      line-height: 1.12;
      color: #0d1b2a;
    }

    .rule {
      width: 48px;
      height: 1px;
      margin-top: 0.9rem;
      background: #d0dce8;
    }

    .services-grid {
      display: grid;
      gap: 1rem;
    }

    .service {
      border: 1px solid #d0dce8;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 2px 16px rgba(13, 27, 42, 0.08);
      overflow: clip;
    }

    .service-head {
      padding: 1.2rem 1rem;
      display: grid;
      gap: 0.5rem;
    }

    .service-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }

    .service-top h3 {
      margin: 0;
      font-size: 1.14rem;
      font-family: var(--font-display);
      color: #0d1b2a;
    }

    .price-range {
      font-size: 0.86rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #1a3a5c;
      white-space: nowrap;
    }

    .service p {
      margin: 0;
      color: #5a6a7a;
      font-size: 0.9rem;
    }

    .service-body {
      padding: 0 1rem 1rem;
    }

    .service-body ul {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid #d0dce8;
    }

    .service-body li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem 1rem;
      padding: 0.8rem 0;
      border-bottom: 1px solid #d0dce8;
      font-size: 0.92rem;
    }

    .service-body li:last-child { border-bottom: 0; }

    .service-book {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 44px;
      margin-top: 0.9rem;
      border: 1px solid #1a3a5c;
      border-radius: 8px;
      background: transparent;
      color: #1a3a5c;
      cursor: pointer;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .service-body li .service-book {
      grid-column: 1 / -1;
      margin-top: 0.1rem;
    }

    .service-book--whatsapp {
      border-color: #25d366;
      color: #147a3a;
    }

    .section-booking {
      background: #0a0f17;
      color: #fff;
    }

    .section-booking .section-head h2 { color: #fff; }
    .section-booking .section-head small { color: rgba(255, 255, 255, 0.58); }
    .section-booking .rule { background: rgba(255, 255, 255, 0.24); }

    .booking-panel {
      max-width: 46rem;
      margin: 0 auto;
      padding: 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.04);
    }

    .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    :global(.booking-step) { margin: 0 0 0.7rem; color: rgba(255, 255, 255, 0.58); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; }
    .booking-title { margin: 0 0 0.55rem; font-family: var(--font-display); font-size: clamp(1.75rem, 8vw, 2.35rem); line-height: 1.08; }
    .booking-service { display: grid; gap: 0.35rem; margin: 1rem 0 1.25rem; padding: 0.9rem 1rem; border: 1px solid rgba(255, 255, 255, 0.18); border-left: 3px solid #c9a55c; border-radius: 8px; background: rgba(255, 255, 255, 0.05); }
    .booking-service--compact { gap: 0.6rem; }
    .booking-service__name { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; }
    .booking-service__price { color: rgba(255, 255, 255, 0.68); font-size: 0.9rem; }
    .booking-service__duration { color: rgba(255, 255, 255, 0.62); font-size: 0.88rem; }
    .booking-form { display: grid; gap: 1rem; }
    .booking-field { display: grid; gap: 0.4rem; }
    .booking-field label { font-size: 0.82rem; font-weight: 700; }
    .booking-field input { width: 100%; min-height: 50px; padding: 0.75rem 0.85rem; border: 1px solid rgba(255, 255, 255, 0.28); border-radius: 8px; background: #fff; color: #0d1b2a; font: inherit; }
    .booking-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
    .booking-button { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0.8rem 1rem; border: 1px solid #fff; border-radius: 8px; background: #fff; color: #0d1b2a; cursor: pointer; font: inherit; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.12em; text-align: center; text-transform: uppercase; transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease; }
    .booking-button:hover { transform: translateY(-1px); }
    .booking-button:disabled { cursor: not-allowed; opacity: 0.46; transform: none; }
    .booking-button--secondary { border-color: rgba(255, 255, 255, 0.42); background: transparent; color: #fff; }
    .booking-button--whatsapp { border-color: #25d366; background: #25d366; color: #fff; }
    :global(.booking-service-options) { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.75rem; margin: 1rem 0 0; padding: 0; border: 0; }
    :global(.booking-service-option) { position: relative; display: grid; grid-template-columns: 1.25rem minmax(0, 1fr) auto; align-items: center; gap: 0.7rem; width: 100%; min-height: 68px; padding: 0.95rem 1rem; border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 8px; background: rgba(255, 255, 255, 0.04); color: #fff; cursor: pointer; font: inherit; text-align: left; transition: background 160ms ease, border-color 160ms ease, transform 160ms ease; }
    :global(.booking-service-option input) { position: absolute; opacity: 0; pointer-events: none; }
    :global(.booking-service-option:hover) { border-color: #c9a55c; background: rgba(201, 165, 92, 0.12); transform: translateY(-1px); }
    :global(.booking-service-option:has(input:focus-visible)) { outline: 3px solid rgba(154, 31, 61, 0.72); outline-offset: 3px; }
    :global(.booking-service-option:has(input:checked)) { border-color: #c9a55c; background: rgba(201, 165, 92, 0.16); box-shadow: inset 3px 0 0 #c9a55c; }
    :global(.booking-service-option__check) { display: grid; width: 1.15rem; height: 1.15rem; place-items: center; border: 1px solid rgba(255, 255, 255, 0.45); border-radius: 4px; color: #0a0f17; background: rgba(255, 255, 255, 0.05); }
    :global(.booking-service-option__check::after) { content: ""; width: 0.35rem; height: 0.65rem; border: solid #0a0f17; border-width: 0 2px 2px 0; opacity: 0; transform: rotate(45deg); }
    :global(.booking-service-option:has(input:checked) .booking-service-option__check) { border-color: #c9a55c; background: #c9a55c; }
    :global(.booking-service-option:has(input:checked) .booking-service-option__check::after) { opacity: 1; }
    :global(.booking-service-option__name) { font-family: var(--font-display); font-size: 1.12rem; line-height: 1.2; }
    :global(.booking-service-option__price) { color: rgba(255, 255, 255, 0.72); font-size: 0.88rem; font-weight: 700; white-space: nowrap; }
    .booking-selection-summary { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.3rem 1rem; margin-top: 1rem; padding: 0.85rem 1rem; border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 8px; background: rgba(255, 255, 255, 0.04); color: rgba(255, 255, 255, 0.72); font-size: 0.92rem; }
    .booking-selection-summary strong { color: #fff; text-align: right; }
    .booking-selection-summary span:last-child { grid-column: 1 / -1; }
    .booking-service-list { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; }
    .booking-service-list li { color: #fff; font-weight: 700; }
    :global(.booking-note), .booking-error { margin: 1rem 0 0; font-size: 0.9rem; }
    :global(.booking-note) { color: rgba(255, 255, 255, 0.7); }
    .booking-error { color: #ffb6c6; }
    .booking-loading { margin: 1.25rem 0 0; color: rgba(255, 255, 255, 0.72); font-size: 0.9rem; }
    .cal-scheduler { min-height: 420px; margin-top: 1rem; overflow: hidden; border-radius: 8px; }
    .cal-scheduler__inline { width: 100%; min-height: 420px; }
    .booking-success { text-align: center; }
    .booking-success-logo { width: min(42vw, 112px); margin: 0 auto 1.1rem; }
    .booking-success-mark { display: grid; width: 2.4rem; height: 2.4rem; margin: 0 auto 1rem; place-items: center; border-radius: 50%; background: #25d366; color: #fff; font-size: 1.35rem; font-weight: 700; line-height: 1; }
    .booking-success h3 { margin: 0 0 0.75rem; font-family: var(--font-display); font-size: clamp(2rem, 8vw, 2.7rem); line-height: 1.1; }
    .booking-success p { margin: 0 0 1.25rem; color: rgba(255, 255, 255, 0.74); }
    .booking-code { display: grid; gap: 0.35rem; margin: 0 auto 1.25rem; padding: 1rem; border: 1px solid rgba(201, 165, 92, 0.52); border-radius: 8px; background: rgba(201, 165, 92, 0.1); }
    .booking-code small { color: rgba(255, 255, 255, 0.66); text-transform: uppercase; letter-spacing: 0.12em; }
    .booking-code strong { color: #e8cb8d; font-size: clamp(2rem, 9vw, 2.8rem); letter-spacing: 0.16em; line-height: 1; }
    .booking-code p { margin: 0; font-size: 0.84rem; }
    .booking-summary { display: grid; gap: 0.7rem; margin: 0 auto 1.5rem; padding: 1rem; border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 8px; text-align: left; }
    .booking-summary div { display: flex; justify-content: space-between; gap: 1rem; }
    .booking-summary .booking-summary__stack { display: grid; gap: 0.4rem; }
    .cancellation-entry { text-align: center; }
    .cancellation-entry p { margin: 0 0 1.1rem; color: rgba(255, 255, 255, 0.72); }
    .cancellation-form { display: grid; gap: 1rem; }
    .cancellation-code-input { font-size: 1.5rem !important; font-weight: 700; letter-spacing: 0.16em; text-align: center; }
    .cancellation-review { display: grid; gap: 1rem; }
    .cancellation-review__question { font-size: 1rem; font-weight: 700; }
    .booking-button--danger { border-color: #b95061; background: #9a1f3d; color: #fff; }
    .booking-button--danger:hover { border-color: #e28a98; background: #b32d4d; }
    .booking-summary small { color: rgba(255, 255, 255, 0.56); text-transform: uppercase; letter-spacing: 0.1em; }
    .booking-summary strong { text-align: right; }
    .booking-price-reminder { margin: -0.55rem 0 1.5rem !important; color: #fff !important; font-size: 0.95rem; }
    .booking-price-reminder strong { color: #e4c379; }
    [hidden] { display: none !important; }
    button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid rgba(154, 31, 61, 0.72); outline-offset: 3px; }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .gallery-cell {
      aspect-ratio: 1;
      border: 1px solid #d0dce8;
      border-radius: 10px;
      overflow: hidden;
      background: #e8edf2;
    }

    .gallery-trigger {
      display: block;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .gallery-cell img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 180ms ease;
    }

    .gallery-trigger:hover img,
    .gallery-trigger:focus-visible img {
      transform: scale(1.03);
    }

    .gallery-trigger:focus-visible {
      outline: 3px solid rgba(26, 58, 92, 0.35);
      outline-offset: -3px;
    }

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: grid;
      place-items: center;
      padding: 1rem;
      background: rgba(0, 0, 0, 0.82);
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }

    .lightbox.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-dialog {
      position: relative;
      width: min(100%, 64rem);
      max-height: min(100dvh - 2rem, 56rem);
      display: grid;
      gap: 0.75rem;
    }

    .lightbox-close {
      position: absolute;
      top: 0.4rem;
      right: 0.4rem;
      z-index: 1;
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.62);
      color: #fff;
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
    }

    .lightbox-frame {
      overflow: hidden;
      border-radius: 14px;
      background: #0a0f17;
      box-shadow: 0 18px 70px rgba(0, 0, 0, 0.35);
    }

    .lightbox-frame img {
      display: block;
      width: 100%;
      max-height: min(100dvh - 2rem, 56rem);
      object-fit: contain;
      background: #0a0f17;
    }

    .lightbox-caption {
      margin: 0;
      text-align: center;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.82rem;
      letter-spacing: 0.08em;
    }

    .hours-table {
      width: 100%;
      border-collapse: collapse;
    }

    .hours-table tr {
      border-bottom: 1px solid #d0dce8;
    }

    .hours-table td {
      padding: 0.85rem 0;
      font-size: 0.94rem;
    }

    .hours-table td:first-child {
      color: #5a6a7a;
    }

    .hours-table td:last-child {
      text-align: right;
      color: #1a1a2e;
      font-weight: 500;
    }

    .contact-grid {
      display: grid;
      gap: 1.5rem;
    }

    .contact-stack {
      display: grid;
      gap: 1rem;
    }

    .contact-item {
      display: grid;
      gap: 0.3rem;
    }

    .contact-item small {
      font-size: 0.72rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: #5a6a7a;
    }

    .contact-item strong,
    .contact-item a,
    .contact-item span {
      color: #1a1a2e;
      font-size: 0.98rem;
      font-weight: 400;
    }

    .contact-actions {
      display: grid;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }

    .contact-actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      border-radius: 10px;
      font-size: 0.82rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .whatsapp {
      background: #25d366;
      color: #fff;
    }

    .instagram {
      border: 1px solid #d0dce8;
      color: #1a1a2e;
    }

    .map {
      width: 100%;
      min-height: 320px;
      border: 1px solid #d0dce8;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 16px rgba(13, 27, 42, 0.08);
    }

    .map iframe {
      width: 100%;
      height: 100%;
      min-height: 320px;
      border: 0;
      display: block;
    }

    .footer {
      background: #f4f7fa;
      color: #1a1a2e;
      text-align: center;
      padding: 2.75rem 1rem 2rem;
      border-top: 1px solid #d0dce8;
    }

    .footer img {
      width: 84px;
      margin: 0 auto 1rem;
    }

    .footer strong {
      display: block;
      margin-bottom: 0.4rem;
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 0.12em;
      color: #0d1b2a;
    }

    .footer p {
      margin: 0;
      color: #5a6a7a;
      font-size: 0.82rem;
    }

    @media (min-width: 700px) {
      .nav { padding-inline: 2rem; }
      .nav-link { padding-inline: 1rem; }
      .hero { background-size: auto; }
      .hero-card { padding: 2.5rem 2rem 2.7rem; }
      .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .gallery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .contact-grid { grid-template-columns: 0.9fr 1.1fr; align-items: start; }
      .contact-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .booking-panel { padding: 1.75rem; }
      :global(.booking-service-options) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (min-width: 420px) {
      .nav-link__mobile { display: none; }
      .nav-link__desktop { display: inline; }
    }

    @media (min-width: 980px) {
      .services-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 699px) {
      .lightbox {
        padding: 0.75rem;
      }

      .lightbox-dialog {
        width: 100%;
        max-height: calc(100dvh - 1.5rem);
      }

      .lightbox-frame img {
        max-height: calc(100dvh - 1.5rem);
      }

      .booking-actions { display: grid; }
      .booking-button { width: 100%; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <nav class="nav">
      <a class="brand" href="#inicio" aria-label="Parthenon Barbearia">
        <img src="/logo.png" alt="Parthenon Barbearia" />
        <span class="brand-copy">
          <small>Barbearia</small>
          <strong>Parthenon</strong>
        </span>
      </a>
      <a class="nav-link" href="#agendar"><span class="nav-link__mobile">Agendar</span><span class="nav-link__desktop">Agendar horário</span></a>
    </nav>

    <section class="hero" id="inicio">
      <div class={`hero-card ${HERO_PANEL_ENABLED ? 'hero-card--panel' : 'hero-card--plain'}`}>
        <img class="hero-logo" src="/logo.png" alt="Parthenon Barbearia" />
        <p class="hero-quote">“Cuidar da aparência não é vaidade — é o respeito silencioso que um homem tem por si mesmo.”</p>
        <p class="hero-byline">{OWNER} · Parthenon Barbearia</p>
        <div class="hero-actions">
          <a class="cta" href="#agendar">Agendar horário</a>
          <a class="cta-secondary" href="#cancelar">Cancelar agendamento</a>
          <a class="cta-secondary" href="#servicos">Ver serviços</a>
        </div>
      </div>
      <div class="scroll-note" aria-hidden="true">
        <span>Rolar</span>
        <span>↓</span>
      </div>
    </section>

    <section class="section-light" id="servicos">
      <div class="container">
        <div class="section-head">
          <small>O que oferecemos</small>
          <h2>Nossos serviços, sem esconder preço.</h2>
          <div class="rule"></div>
        </div>
        <div class="services-grid">
          {servicesByGroup.map(group => (
            <article class="service">
              <div class="service-head">
                <div class="service-top">
                  <h3>{group.name}</h3>
                  <span class="price-range">{group.range}</span>
                </div>
              </div>
              <div class="service-body">
                <ul>
                  {group.services.map(service => (
                    <li>
                      <span>{service.name}</span>
                      <strong>{service.price}</strong>
                      {service.bookingMode === 'whatsapp' && (
                        <a
                          class="service-book service-book--whatsapp"
                          href={`${WHATSAPP_URL}?text=${encodeURIComponent(`Olá! Vi o serviço de ${service.name} no site da Parthenon e gostaria de conversar sobre ele antes de agendar.`)}`}
                          target="_blank"
                          rel="noopener"
                        >
                          Falar no WhatsApp
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-booking" id="agendar" aria-labelledby="booking-heading">
      <div class="container">
        <div class="section-head">
          <small>Agendamento online</small>
          <h2 id="booking-heading">Escolha seu horário.</h2>
          <div class="rule"></div>
        </div>
        <div class="booking-panel" id="booking-panel">
          <div id="booking-selection">
            <p class="booking-step">1. Serviços</p>
            <h3 class="booking-title">Escolha seus serviços</h3>
            <p class="booking-note">Selecione tudo o que deseja fazer neste atendimento.</p>
            <fieldset class="booking-service-options" id="booking-service-options" aria-describedby="booking-selection-summary">
              <legend class="sr-only">Serviços para agendar</legend>
              {calendarServices.map(service => (
                <label class="booking-service-option" data-booking-option>
                  <input type="checkbox" name="booking-services" value={service.id} />
                  <span class="booking-service-option__check" aria-hidden="true"></span>
                  <span class="booking-service-option__name">{service.name}</span>
                  <span class="booking-service-option__price">{service.price}</span>
                </label>
              ))}
            </fieldset>
            <div class="booking-selection-summary" id="booking-selection-summary" aria-live="polite">
              <span id="booking-selected-count">0 serviços selecionados</span>
              <strong id="booking-selected-total">Total: R$ 0</strong>
              <span>Tempo do atendimento: 50 minutos</span>
            </div>
            <div class="booking-actions">
              <button class="booking-button" id="booking-continue" type="button" disabled>CONTINUAR</button>
            </div>
          </div>
          <div id="booking-calendar" hidden>
            <p class="booking-step">2. Data e horário</p>
            <div class="booking-service booking-service--compact">
              <span class="booking-service__name">Atendimento Parthenon</span>
              <ul class="booking-service-list" id="booking-calendar-services"></ul>
              <span class="booking-service__price" id="booking-calendar-price"></span>
              <span class="booking-service__duration">50 minutos</span>
            </div>
            <p class="booking-loading" id="booking-calendar-loading" role="status">Carregando horários disponíveis...</p>
            <div class="cal-scheduler" id="cal-scheduler" aria-live="polite"></div>
            <p class="booking-error" id="booking-cal-error" role="alert" hidden></p>
            <div class="booking-actions">
              <button class="booking-button booking-button--secondary" type="button" data-booking-change>ALTERAR SERVIÇOS</button>
            </div>
          </div>
          <div class="booking-success" id="booking-success" hidden aria-live="polite">
            <p class="booking-step">Agendamento confirmado</p>
            <img class="booking-success-logo" src="/logo.png" alt="Parthenon Barbearia" />
            <span class="booking-success-mark" aria-hidden="true">✓</span>
            <h3>Horário confirmado!</h3>
            <p id="booking-success-copy"></p>
            <div class="booking-summary">
              <div class="booking-summary__stack"><small>Serviços</small><ul class="booking-service-list" id="booking-success-services"></ul></div>
              <div><small>Data</small><strong id="booking-success-date"></strong></div>
              <div><small>Horário</small><strong id="booking-success-time"></strong></div>
            </div>
            <p class="booking-price-reminder">Valor total: <strong id="booking-success-price"></strong></p>
            <div class="booking-code" id="booking-code-panel" hidden>
              <small>Código do agendamento</small>
              <strong id="booking-cancellation-code"></strong>
              <p id="booking-code-helper">Guarde este código. Ele será pedido junto ao telefone se precisar cancelar.</p>
            </div>
            <p>Seu horário já está confirmado. Para facilitar o contato com a barbearia, você pode enviar uma confirmação pelo WhatsApp. A mensagem já estará pronta. É só enviar.</p>
            <div class="booking-actions">
              <a class="booking-button booking-button--whatsapp" id="booking-whatsapp-confirmation" target="_blank" rel="noopener">Abrir WhatsApp</a>
              <a class="booking-button booking-button--secondary" id="booking-back-home" href="#inicio">Voltar ao início</a>
            </div>
          </div>
          <div class="cancellation-entry" id="cancellation-entry" hidden aria-live="polite">
            <p class="booking-step">Cancelar agendamento</p>
            <h3 class="booking-title">Cancelar agendamento</h3>
            <p>Informe o código do agendamento e o telefone usado na reserva.</p>
            <form class="cancellation-form" id="cancellation-form">
              <div class="booking-field"><label for="cancellation-code">Código do agendamento</label><input class="cancellation-code-input" id="cancellation-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="4" pattern="[0-9]{4}" placeholder="0000" required /></div>
              <div class="booking-field"><label for="cancellation-phone">Telefone</label><input id="cancellation-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(34) 99999-9999" required /></div>
              <p class="booking-error" id="cancellation-error" role="alert" hidden></p>
              <div class="booking-actions"><button class="booking-button" type="submit">CONTINUAR</button><a class="booking-button booking-button--secondary" href="#inicio" data-cancellation-home>VOLTAR AO INÍCIO</a></div>
            </form>
          </div>
          <div class="cancellation-review" id="cancellation-review" hidden aria-live="polite">
            <p class="booking-step">Cancelar agendamento</p>
            <h3 class="booking-title">Encontramos seu agendamento</h3>
            <div class="booking-summary"><div class="booking-summary__stack"><small>Serviços</small><ul class="booking-service-list" id="cancellation-services"></ul></div><div><small>Data</small><strong id="cancellation-date"></strong></div><div><small>Horário</small><strong id="cancellation-time"></strong></div><div><small>Valor total</small><strong id="cancellation-price"></strong></div></div>
            <p class="cancellation-review__question">Tem certeza de que deseja cancelar este agendamento?</p>
            <p class="booking-error" id="cancellation-review-error" role="alert" hidden></p>
            <div class="booking-actions"><button class="booking-button booking-button--secondary" id="cancellation-keep" type="button">MANTER AGENDAMENTO</button><button class="booking-button booking-button--danger" id="cancellation-confirm" type="button">SIM, CANCELAR AGENDAMENTO</button></div>
          </div>
          <div class="booking-success" id="cancellation-success" hidden aria-live="polite">
            <p class="booking-step">Cancelamento confirmado</p><img class="booking-success-logo" src="/logo.png" alt="Parthenon Barbearia" /><span class="booking-success-mark" aria-hidden="true">✓</span><h3>Agendamento cancelado</h3><p>Seu agendamento foi cancelado com sucesso.</p>
            <div class="booking-actions"><a class="booking-button booking-button--secondary" href="#inicio" data-cancellation-home>VOLTAR AO INÍCIO</a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-white" id="galeria">
      <div class="container">
        <div class="section-head">
          <small>Nosso trabalho</small>
          <h2>Galeria</h2>
          <div class="rule"></div>
        </div>
        <div class="gallery-grid">
          {gallery.map((src, index) => (
            <div class="gallery-cell">
              <button
                class="gallery-trigger"
                type="button"
                data-gallery-trigger
                data-gallery-src={src}
                data-gallery-alt={`Trabalho ${index + 1} da Parthenon Barbearia`}>
                <img src={src} alt={`Trabalho ${index + 1} da Parthenon Barbearia`} loading="lazy" />
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-light" id="horarios">
      <div class="container">
        <div class="section-head">
          <small>Quando estamos abertos</small>
          <h2>Horários de funcionamento</h2>
          <div class="rule"></div>
        </div>
        <table class="hours-table">
          <tbody>
            {hours.map(h => (
              <tr><td>{h.day}</td><td>{h.value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-white" id="contato">
      <div class="container">
        <div class="section-head">
          <small>Fale conosco</small>
          <h2>Contato e localização</h2>
          <div class="rule"></div>
        </div>
        <div class="contact-grid">
          <div class="contact-stack">
            <div class="contact-item">
              <small>Barbeiro</small>
              <strong>{OWNER}</strong>
            </div>
            <div class="contact-item">
              <small>Endereço</small>
              <span>Rua da Fartura, 1767<br />Bairro Minas Gerais<br />Uberlândia – MG</span>
            </div>
            <div class="contact-item">
              <small>Telefone / WhatsApp</small>
              <a href={`tel:${WHATSAPP_URL.replace('https://wa.me/','')}`}>{WHATSAPP_TEL}</a>
            </div>
            <div class="contact-item">
              <small>E-mail</small>
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </div>
            <div class="contact-actions">
              <a class="whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener">Chamar no WhatsApp</a>
              <a class="instagram" href={INSTAGRAM_URL} target="_blank" rel="noopener">@parthenonbarbearia</a>
            </div>
          </div>
          <div class="map">
            <iframe
              src="https://maps.google.com/maps?q=Rua+da+Fartura,+1767,+Uberlândia,+MG,+Brasil&output=embed&hl=pt-BR"
              title="Localização da Parthenon Barbearia"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </section>

    <footer class="footer">
      <img src="/logo.png" alt="Parthenon Barbearia" />
      <strong>Parthenon Barbearia</strong>
      <p>&copy; 2025 Barbearia Parthenon — Uberlândia, MG</p>
    </footer>
  </div>

  <div class="lightbox" id="gallery-lightbox" aria-hidden="true">
    <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Imagem ampliada">
      <button class="lightbox-close" type="button" aria-label="Fechar imagem" data-lightbox-close>&times;</button>
      <div class="lightbox-frame">
        <img id="lightbox-image" src="" alt="" />
      </div>
      <p class="lightbox-caption" id="lightbox-caption"></p>
    </div>
  </div>

  <script id="booking-config" type="application/json" set:html={JSON.stringify({ services: bookingServices, calendar: calendarBooking, whatsappUrl: WHATSAPP_URL })}></script>

  <script is:inline>
    const bookingConfig = JSON.parse(document.getElementById('booking-config')?.textContent || '{"services":[],"calendar":{}}');
    const bookingServicesById = new Map(bookingConfig.services.map((service) => [service.id, service]));
    const bookingPanel = document.getElementById('booking-panel');
    const bookingSelection = document.getElementById('booking-selection');
    const bookingCalendar = document.getElementById('booking-calendar');
    const bookingSuccess = document.getElementById('booking-success');
    const cancellationEntry = document.getElementById('cancellation-entry');
    const cancellationReview = document.getElementById('cancellation-review');
    const cancellationSuccess = document.getElementById('cancellation-success');
    const bookingCalError = document.getElementById('booking-cal-error');
    const bookingCalendarLoading = document.getElementById('booking-calendar-loading');
    const calendarHost = document.getElementById('cal-scheduler');
    const bookingContinue = document.getElementById('booking-continue');
    const bookingSelectedCount = document.getElementById('booking-selected-count');
    const bookingSelectedTotal = document.getElementById('booking-selected-total');
    const bookingCalendarServices = document.getElementById('booking-calendar-services');
    const bookingCalendarPrice = document.getElementById('booking-calendar-price');
    const calendarConfig = bookingConfig.calendar || {};
    const CAL_NAMESPACE = 'atendimento-parthenon';
    const CAL_INLINE_ID = 'my-cal-inline-atendimento-parthenon';
    let selectedBookingServiceIds = new Set();
    let calEmbedInitialized = false;
    let calEmbedLoadPromise = null;
    let calEmbedMounting = false;
    let cancellationCredentials = null;

    const currency = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });

    const setBookingView = (view) => {
      [bookingSelection, bookingCalendar, bookingSuccess, cancellationEntry, cancellationReview, cancellationSuccess].forEach((element) => {
        element.hidden = element !== view;
      });
    };

    const enterBookingMode = () => {
      document.body.classList.add('is-booking');
    };

    const exitBookingMode = () => {
      document.body.classList.remove('is-booking');
    };

    const cancellationErrorMessage = (code) => ({
      INVALID_INPUT: 'Confira o código e o telefone informado.',
      NOT_FOUND: 'Não encontramos um agendamento ativo com esses dados. Confira o código e o telefone e tente novamente.',
      RATE_LIMITED: 'Muitas tentativas. Aguarde alguns minutos e tente novamente.',
      BOOKING_EXPIRED: 'Este agendamento já passou e não pode mais ser cancelado pelo site.',
      ALREADY_CANCELLED: 'Este agendamento já foi cancelado.',
      CANCELLATION_NOT_CONFIGURED: 'O cancelamento online ainda está sendo preparado. Fale com a barbearia pelo WhatsApp.',
      CAL_UNAVAILABLE: 'Não foi possível confirmar o cancelamento agora. Tente novamente em alguns minutos.',
      INTERNAL_ERROR: 'Não foi possível concluir agora. Tente novamente em alguns minutos.',
    })[code] || 'Não foi possível concluir agora. Tente novamente.';

    const setCancellationError = (target, code) => {
      target.textContent = cancellationErrorMessage(code);
      target.hidden = false;
    };

    const resetCancellation = () => {
      cancellationCredentials = null;
      document.getElementById('cancellation-form').reset();
      ['cancellation-error', 'cancellation-review-error'].forEach((id) => {
        const target = document.getElementById(id); target.hidden = true; target.textContent = '';
      });
      document.getElementById('cancellation-services').replaceChildren();
      ['cancellation-date', 'cancellation-time', 'cancellation-price'].forEach((id) => { document.getElementById(id).textContent = ''; });
    };

    const showCancellationEntry = () => {
      enterBookingMode();
      resetCancellation();
      setBookingView(cancellationEntry);
      scrollToBooking();
    };

    const scrollToBooking = () => {
      if (!bookingPanel) return;
      window.scrollTo({ top: bookingPanel.getBoundingClientRect().top + window.scrollY, behavior: 'auto' });
    };

    const clearBookingErrors = () => {
      bookingCalError.hidden = true;
      bookingCalError.textContent = '';
    };

    const selectedBookingServices = () => [...selectedBookingServiceIds]
      .map((serviceId) => bookingServicesById.get(serviceId))
      .filter((service) => service?.bookingMode === 'calendar');

    const selectedServicesLabel = () => selectedBookingServices().map((service) => service.name).join(', ');

    const selectedServicesTotal = () => selectedBookingServices()
      .reduce((total, service) => total + (Number.isFinite(service.priceValue) ? service.priceValue : 0), 0);

    const selectedServicesTotalLabel = () => currency.format(selectedServicesTotal());

    const renderServiceList = (target, services) => {
      target.replaceChildren(...services.map((service) => {
        const item = document.createElement('li');
        item.textContent = service.name;
        return item;
      }));
    };

    const syncServiceSelection = () => {
      const services = selectedBookingServices();
      const count = services.length;
      bookingSelectedCount.textContent = count === 1 ? '1 servi\u00e7o selecionado' : `${count} servi\u00e7os selecionados`;
      bookingSelectedTotal.textContent = `Total: ${selectedServicesTotalLabel()}`;
      bookingContinue.disabled = count === 0;
      document.querySelectorAll('input[name="booking-services"]').forEach((input) => {
        input.checked = selectedBookingServiceIds.has(input.value);
      });
    };

    const dateParts = (dateString) => {
      const date = new Date(dateString);
      if (Number.isNaN(date.getTime())) return null;
      return {
        date: new Intl.DateTimeFormat('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Sao_Paulo' }).format(date),
        time: new Intl.DateTimeFormat('pt-BR', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Sao_Paulo' }).format(date),
      };
    };

    const calLinkValue = (calLink) => calLink.replace(/^https?:\/\/(?:app\.)?cal\.com\//, '').replace(/^\//, '').trim();

    const showSelectionStep = ({ clearSelection = false, clearClientDetails = false } = {}) => {
      enterBookingMode();
      if (clearSelection) selectedBookingServiceIds = new Set();
      if (clearClientDetails) {
        document.getElementById('booking-success-copy').textContent = '';
        document.getElementById('booking-success-services').replaceChildren();
        document.getElementById('booking-success-date').textContent = '';
        document.getElementById('booking-success-time').textContent = '';
        document.getElementById('booking-success-price').textContent = '';
        document.getElementById('booking-whatsapp-confirmation').removeAttribute('href');
        document.getElementById('booking-code-panel').hidden = true;
        document.getElementById('booking-cancellation-code').textContent = '';
      }
      calendarHost.replaceChildren();
      calEmbedMounting = false;
      bookingCalendarLoading.hidden = true;
      clearBookingErrors();
      syncServiceSelection();
      setBookingView(bookingSelection);
      scrollToBooking();
    };

    const loadCalEmbed = () => {
      if (calEmbedLoadPromise) return calEmbedLoadPromise;
      if (window.Cal?.loaded) return Promise.resolve(window.Cal);
      calEmbedLoadPromise = new Promise((resolve, reject) => {
        const queuedCal = window.Cal || function () {
          const cal = window.Cal;
          const args = arguments;
          if (args[0] === 'init') {
            const namespace = args[1];
            const api = function () { api.q.push(arguments); };
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = cal.ns[namespace] || api;
              cal.ns[namespace].q.push(args);
              cal.q.push(['initNamespace', namespace]);
            } else {
              cal.q.push(args);
            }
            return;
          }
          cal.q.push(args);
        };
        queuedCal.ns = queuedCal.ns || {};
        queuedCal.q = queuedCal.q || [];
        queuedCal.loaded = true;
        window.Cal = queuedCal;
        const script = document.createElement('script');
        script.src = 'https://app.cal.com/embed/embed.js';
        script.async = true;
        script.onload = () => window.Cal ? resolve(window.Cal) : reject(new Error('Cal.com indispon\u00edvel.'));
        script.onerror = () => reject(new Error('N\u00e3o foi poss\u00edvel carregar o calend\u00e1rio.'));
        document.head.append(script);
      });
      calEmbedLoadPromise.catch(() => { calEmbedLoadPromise = null; });
      return calEmbedLoadPromise;
    };

    const bookingGuestName = (booking) => {
      const responses = booking.responses || booking.booking?.responses || {};
      const attendees = booking.attendees || booking.booking?.attendees || [];
      return booking.name || booking.attendee?.name || attendees[0]?.name || responses.name?.value || responses.name || 'Cliente';
    };

    const bookingPhone = (booking) => {
      const source = booking.booking || booking;
      const responses = booking.responses || source.responses || source.bookingFieldsResponses || {};
      const attendees = booking.attendees || source.attendees || [];
      return booking.attendee?.phoneNumber || source.attendee?.phoneNumber || attendees[0]?.phoneNumber || responses.attendeePhoneNumber?.value || responses.attendeePhoneNumber || responses.phone?.value || responses.phone || '';
    };

    const bookingUid = (booking) => booking.uid || booking.bookingUid || booking.booking?.uid || booking.booking?.bookingUid || '';

    const registerCancellationCode = async (booking, services, appointmentStart, appointmentEnd) => {
      const uid = bookingUid(booking);
      const phone = bookingPhone(booking);
      const codePanel = document.getElementById('booking-code-panel');
      const codeTarget = document.getElementById('booking-cancellation-code');
      const helper = document.getElementById('booking-code-helper');
      if (!uid || !phone) return;
      codePanel.hidden = false;
      codeTarget.textContent = '••••';
      helper.textContent = 'Preparando seu código de cancelamento…';
      try {
        const response = await fetch('/api/cancellations/register', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ bookingUid: uid, phone, services: services.map((service) => ({ id: service.id, name: service.name, priceCents: Math.round(service.priceValue * 100) })), appointmentStart, appointmentEnd }) });
        const payload = await response.json();
        if (!response.ok || !payload.ok || !/^\d{4}$/.test(payload.code)) throw new Error(payload.code || 'registration failed');
        codeTarget.textContent = payload.code;
        helper.textContent = 'Guarde este código. Ele será pedido junto ao telefone se precisar cancelar.';
        return payload.code;
      } catch {
        codePanel.hidden = true;
        return null;
      }
    };

    const showBookingSuccess = async (booking) => {
      const services = selectedBookingServices();
      if (!services.length) return;
      const parts = dateParts(booking.startTime || booking.booking?.startTime);
      const name = bookingGuestName(booking);
      const formattedDate = parts?.date || 'Data confirmada no Cal.com';
      const formattedTime = parts?.time || 'Hor\u00e1rio confirmado no Cal.com';
      const total = selectedServicesTotalLabel();
      document.getElementById('booking-success-copy').textContent = `${name}, seu hor\u00e1rio est\u00e1 confirmado.`;
      renderServiceList(document.getElementById('booking-success-services'), services);
      document.getElementById('booking-success-date').textContent = formattedDate;
      document.getElementById('booking-success-time').textContent = formattedTime;
      document.getElementById('booking-success-price').textContent = total;
      const serviceLines = services.map((service) => `* ${service.name}`);
      const buildMessage = (cancellationCode) => [
        'Ol\u00e1! Acabei de fazer um agendamento pelo site da Parthenon.',
        '',
        `Nome: ${name}`,
        '',
        'Servi\u00e7os:',
        '',
        ...serviceLines,
        '',
        `Data: ${formattedDate}`,
        `Hor\u00e1rio: ${formattedTime}`,
        `Valor informado no site: ${total}`,
        ...(cancellationCode ? ['', `Código para cancelamento: ${cancellationCode}`] : []),
        '',
        'Meu hor\u00e1rio j\u00e1 foi confirmado pelo site.',
      ].join('\n');
      calendarHost.replaceChildren();
      setBookingView(bookingSuccess);
      scrollToBooking();
      const cancellationCode = await registerCancellationCode(booking, services, booking.startTime || booking.booking?.startTime, booking.endTime || booking.booking?.endTime || null);
      document.getElementById('booking-whatsapp-confirmation').href = `${bookingConfig.whatsappUrl}?text=${encodeURIComponent(buildMessage(cancellationCode))}`;
    };

    const showCalendarStep = async () => {
      const services = selectedBookingServices();
      if (!services.length || calEmbedMounting) return;
      clearBookingErrors();
      renderServiceList(bookingCalendarServices, services);
      bookingCalendarPrice.textContent = `Valor total: ${selectedServicesTotalLabel()}`;
      setBookingView(bookingCalendar);
      bookingCalendarLoading.hidden = false;
      calEmbedMounting = true;
      scrollToBooking();

      if (!calendarConfig.genericCalLink) {
        calEmbedMounting = false;
        bookingCalendarLoading.hidden = true;
        bookingCalError.textContent = 'O calend\u00e1rio Atendimento Parthenon ainda precisa ser configurado. Fale com Marco pelo WhatsApp para agendar agora.';
        bookingCalError.hidden = false;
        return;
      }

      try {
        const Cal = await loadCalEmbed();
        if (!calEmbedInitialized) {
          Cal('init', CAL_NAMESPACE, { origin: 'https://app.cal.com' });
          Cal.config = Cal.config || {};
          Cal.config.forwardQueryParams = true;
          const CalAtendimentoParthenon = Cal.ns?.[CAL_NAMESPACE];
          if (!CalAtendimentoParthenon) throw new Error('O calend\u00e1rio n\u00e3o foi inicializado corretamente.');
          CalAtendimentoParthenon('on', { action: 'bookingSuccessfulV2', callback: (event) => showBookingSuccess(event.detail?.data || {}) });
          CalAtendimentoParthenon('on', { action: 'linkReady', callback: () => {
            calEmbedMounting = false;
            bookingCalendarLoading.hidden = true;
          }});
          CalAtendimentoParthenon('on', { action: 'linkFailed', callback: (event) => {
            calEmbedMounting = false;
            console.warn('Falha ao carregar o embed do Cal.com.', event.detail?.data);
            bookingCalendarLoading.hidden = true;
            bookingCalError.textContent = 'N\u00e3o foi poss\u00edvel abrir o calend\u00e1rio agora. Tente novamente ou fale com Marco pelo WhatsApp.';
            bookingCalError.hidden = false;
          }});
          calEmbedInitialized = true;
        }
        calendarHost.replaceChildren();
        const inlineContainer = document.createElement('div');
        inlineContainer.id = CAL_INLINE_ID;
        inlineContainer.className = 'cal-scheduler__inline';
        calendarHost.append(inlineContainer);
        const CalAtendimentoParthenon = Cal.ns?.[CAL_NAMESPACE];
        if (!CalAtendimentoParthenon) throw new Error('O calend\u00e1rio n\u00e3o foi inicializado corretamente.');
        const config = {
          layout: 'month_view',
          useSlotsViewOnSmallScreen: 'true',
          theme: 'auto',
        };
        if (calendarConfig.selectedServicesQuestionId) {
          config[calendarConfig.selectedServicesQuestionId] = selectedServicesLabel();
        }
        CalAtendimentoParthenon('inline', {
          elementOrSelector: `#${CAL_INLINE_ID}`,
          calLink: calLinkValue(calendarConfig.genericCalLink),
          config,
        });
        CalAtendimentoParthenon('ui', { hideEventTypeDetails: false, layout: 'month_view' });
      } catch (error) {
        calEmbedMounting = false;
        bookingCalendarLoading.hidden = true;
        bookingCalError.textContent = 'N\u00e3o foi poss\u00edvel abrir o calend\u00e1rio agora. Tente novamente ou fale com Marco pelo WhatsApp.';
        bookingCalError.hidden = false;
      }
    };

    document.querySelectorAll('input[name="booking-services"]').forEach((input) => {
      input.addEventListener('change', () => {
        const service = bookingServicesById.get(input.value);
        if (!service || service.bookingMode !== 'calendar') {
          input.checked = false;
          return;
        }
        if (input.checked) selectedBookingServiceIds.add(input.value);
        else selectedBookingServiceIds.delete(input.value);
        syncServiceSelection();
      });
    });

    bookingContinue.addEventListener('click', showCalendarStep);

    document.querySelectorAll('a[href="#cancelar"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        window.history.replaceState(null, '', '#cancelar');
        showCancellationEntry();
      });
    });

    document.getElementById('cancellation-code').addEventListener('input', (event) => {
      event.target.value = event.target.value.replace(/\D/g, '').slice(0, 4);
    });
    document.getElementById('cancellation-phone').addEventListener('input', (event) => {
      const digits = event.target.value.replace(/\D/g, '').replace(/^55(?=\d{10,11}$)/, '').slice(0, 11);
      event.target.value = digits.length > 6 ? `(${digits.slice(0, 2)}) ${digits.slice(2, digits.length === 11 ? 7 : 6)}-${digits.slice(digits.length === 11 ? 7 : 6)}` : digits.length > 2 ? `(${digits.slice(0, 2)}) ${digits.slice(2)}` : digits;
    });
    document.getElementById('cancellation-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const error = document.getElementById('cancellation-error'); error.hidden = true;
      const form = new FormData(event.currentTarget);
      const code = String(form.get('code') || '').replace(/\s/g, '');
      const phone = String(form.get('phone') || '');
      const submit = event.currentTarget.querySelector('button[type="submit"]'); submit.disabled = true;
      try {
        const response = await fetch('/api/cancellations/lookup', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code, phone }) });
        const payload = await response.json();
        if (!response.ok || !payload.ok) { setCancellationError(error, payload.code); return; }
        cancellationCredentials = { code, phone };
        const booking = payload.booking;
        renderServiceList(document.getElementById('cancellation-services'), booking.services || []);
        const parts = dateParts(booking.appointmentStart);
        document.getElementById('cancellation-date').textContent = parts?.date || 'Data confirmada no Cal.com';
        document.getElementById('cancellation-time').textContent = parts?.time || 'Horário confirmado no Cal.com';
        document.getElementById('cancellation-price').textContent = currency.format((booking.totalPriceCents || 0) / 100);
        setBookingView(cancellationReview);
        scrollToBooking();
      } catch { setCancellationError(error, 'CAL_UNAVAILABLE'); } finally { submit.disabled = false; }
    });
    document.getElementById('cancellation-keep').addEventListener('click', showCancellationEntry);
    document.getElementById('cancellation-confirm').addEventListener('click', async (event) => {
      if (!cancellationCredentials) return showCancellationEntry();
      const error = document.getElementById('cancellation-review-error'); error.hidden = true;
      const button = event.currentTarget; button.disabled = true;
      try {
        const response = await fetch('/api/cancellations/cancel', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(cancellationCredentials) });
        const payload = await response.json();
        if (!response.ok || !payload.ok) { setCancellationError(error, payload.code); return; }
        cancellationCredentials = null;
        setBookingView(cancellationSuccess);
        scrollToBooking();
      } catch { setCancellationError(error, 'CAL_UNAVAILABLE'); } finally { button.disabled = false; }
    });

    document.querySelectorAll('a[href="#agendar"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        enterBookingMode();
        window.history.replaceState(null, '', '#agendar');
        syncServiceSelection();
        setBookingView(bookingSelection);
        scrollToBooking();
      });
    });

    document.querySelectorAll('[data-booking-change]').forEach((button) => {
      button.addEventListener('click', () => showSelectionStep());
    });

    document.getElementById('booking-back-home')?.addEventListener('click', () => {
      exitBookingMode();
      selectedBookingServiceIds = new Set();
      document.getElementById('booking-success-copy').textContent = '';
      document.getElementById('booking-success-services').replaceChildren();
      document.getElementById('booking-success-date').textContent = '';
      document.getElementById('booking-success-time').textContent = '';
      document.getElementById('booking-success-price').textContent = '';
      document.getElementById('booking-whatsapp-confirmation').removeAttribute('href');
      document.getElementById('booking-code-panel').hidden = true;
      document.getElementById('booking-cancellation-code').textContent = '';
      calendarHost.replaceChildren();
      syncServiceSelection();
      setBookingView(bookingSelection);
    });

    document.querySelectorAll('[data-cancellation-home]').forEach((link) => link.addEventListener('click', () => {
      resetCancellation();
      exitBookingMode();
      setBookingView(bookingSelection);
    }));

    window.addEventListener('hashchange', () => {
      if (!window.location.hash || window.location.hash === '#inicio') exitBookingMode();
      if (window.location.hash === '#agendar') enterBookingMode();
      if (window.location.hash === '#cancelar') showCancellationEntry();
    });

    syncServiceSelection();
    if (window.location.hash === '#agendar') enterBookingMode();
    if (window.location.hash === '#cancelar') showCancellationEntry();

    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const triggers = document.querySelectorAll('[data-gallery-trigger]');
    const closeButton = document.querySelector('[data-lightbox-close]');

    const openLightbox = (src, alt) => {
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      lightboxCaption.textContent = alt;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImage.src = '';
      lightboxImage.alt = '';
      lightboxCaption.textContent = '';
      document.body.style.overflow = '';
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        openLightbox(trigger.dataset.gallerySrc, trigger.dataset.galleryAlt);
      });
    });

    closeButton?.addEventListener('click', closeLightbox);

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && lightbox?.classList.contains('is-open')) closeLightbox();
    });
  </script>

</body>
</html>
