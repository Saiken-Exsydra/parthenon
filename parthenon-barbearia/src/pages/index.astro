---
import { business, bookingServices, serviceGroups, whatsappUrl } from '../data/business';

const { email: EMAIL, instagramUrl: INSTAGRAM_URL, owner: OWNER, whatsappDisplay: WHATSAPP_TEL } = business;
const WHATSAPP_URL = whatsappUrl;
const HERO_PANEL_ENABLED = false;
const servicesByGroup = serviceGroups.map(group => ({
  ...group,
  services: group.serviceIds
    .map(serviceId => bookingServices.find(service => service.id === serviceId))
    .filter(Boolean),
}));

const hours = [
  { day: 'Segunda-feira', value: '10h às 19h' },
  { day: 'Terça-feira', value: '10h às 20h' },
  { day: 'Quarta-feira', value: '10h às 20h' },
  { day: 'Quinta-feira', value: '10h às 18h' },
  { day: 'Sexta-feira', value: '12h às 18h' },
  { day: 'Sábado', value: '10h às 17h' },
];

const gallery = [
  '/uploads/2020-08-04.jpg',
  '/uploads/2020-08-04s.jpg',
  '/uploads/2020-08-0d4.jpg',
  '/uploads/2020-08dd-04.jpg',
  '/uploads/B271D041-2BA0-473C-9174-6C53C7003BF3.jpeg',
  '/uploads/B9B906E5-0986-4986-AFED-77EC5CA97CE6.jpeg',
];
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="Parthenon Barbearia — cortes, barba, sobrancelha, pezinho e tratamentos capilares em Uberlândia, MG. Agende com Marco Antônio pelo WhatsApp." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Parthenon Barbearia — Uberlândia, MG</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=Playfair+Display:wght@400;700;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #020202;
      --surface: #0a0f17;
      --surface-soft: rgba(8, 13, 22, 0.78);
      --ink: #ffffff;
      --muted: rgba(255, 255, 255, 0.62);
      --line: rgba(255, 255, 255, 0.11);
      --accent: #9a1f3d;
      --navy: #182866;
      --radius: 12px;
      --section-space: 4.5rem;
      --hero-card-shadow-alpha: 0.52;
      --hero-bg-y-offset: 56px;
      --font-display: "Playfair Display", Georgia, serif;
      --font-body: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #030303;
      color: var(--ink);
      font-family: var(--font-body);
      line-height: 1.65;
      min-width: 320px;
    }

    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; }

    .shell {
      background: #030303;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.8rem 1rem;
      background: rgba(255, 255, 255, 0.94);
      border-bottom: 1px solid rgba(13, 27, 42, 0.08);
      backdrop-filter: blur(10px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .brand img {
      width: 52px;
      mix-blend-mode: normal;
    }

    .brand-copy {
      display: grid;
      gap: 0.1rem;
    }

    .brand-copy small {
      font-size: 0.68rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(13, 27, 42, 0.52);
    }

    .brand-copy strong {
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 0.06em;
      font-weight: 900;
      color: #0d1b2a;
    }

    .nav-link {
      padding: 0.8rem 1rem;
      border: 1px solid rgba(13, 27, 42, 0.16);
      border-radius: var(--radius);
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #0d1b2a;
    }

    .hero {
      position: relative;
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: 5.5rem 1rem 2rem;
      background-color: #000;
      background-image: url("/uploads/wood.png");
      background-repeat: repeat;
      background-position: left var(--hero-bg-y-offset);
      background-size: 720px auto;
      overflow: clip;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.2);
    }

    .hero-card {
      position: relative;
      z-index: 1;
      width: min(100%, 33rem);
      text-align: center;
      padding: 2rem 1.25rem 2.2rem;
    }

    .hero-card--panel {
      background: rgba(0, 0, 0, 0.62);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      box-shadow: 0 0 90px 48px rgba(0, 0, 0, var(--hero-card-shadow-alpha));
    }

    .hero-card--plain {
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .hero-logo {
      width: min(72vw, 220px);
      margin: 0 auto 1.75rem;
      mix-blend-mode: screen;
      filter: saturate(1.35) contrast(1.18) brightness(1.14);
    }

    .hero-quote {
      margin: 0 0 0.85rem;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.7rem, 6vw, 2.5rem);
      line-height: 1.25;
    }

    .hero-byline {
      margin: 0 0 1.75rem;
      font-size: 0.72rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
    }

    .hero-actions {
      display: grid;
      gap: 0.75rem;
    }

    .cta,
    .cta-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0.95rem 1.2rem;
      border-radius: var(--radius);
      font-size: 0.78rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .cta {
      border: 1px solid rgba(255, 255, 255, 0.56);
      background: transparent;
      color: #fff;
    }

    .cta-secondary {
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(255, 255, 255, 0.82);
    }

    .scroll-note {
      position: absolute;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
      display: grid;
      justify-items: center;
      gap: 0.25rem;
      font-size: 0.64rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.34);
    }

    .container {
      width: min(100% - 2rem, 68rem);
      margin: 0 auto;
    }

    section:not(.hero) {
      padding: var(--section-space) 0;
    }

    .section-light {
      background: #f4f7fa;
      color: #1a1a2e;
    }

    .section-white {
      background: #ffffff;
      color: #1a1a2e;
    }

    .section-head {
      margin-bottom: 2rem;
    }

    .section-head small {
      display: block;
      margin-bottom: 0.65rem;
      font-size: 0.72rem;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: #5a6a7a;
    }

    .section-head h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2rem, 7vw, 3rem);
      line-height: 1.12;
      color: #0d1b2a;
    }

    .rule {
      width: 48px;
      height: 1px;
      margin-top: 0.9rem;
      background: #d0dce8;
    }

    .services-grid {
      display: grid;
      gap: 1rem;
    }

    .service {
      border: 1px solid #d0dce8;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 2px 16px rgba(13, 27, 42, 0.08);
      overflow: clip;
    }

    .service-head {
      padding: 1.2rem 1rem;
      display: grid;
      gap: 0.5rem;
    }

    .service-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }

    .service-top h3 {
      margin: 0;
      font-size: 1.14rem;
      font-family: var(--font-display);
      color: #0d1b2a;
    }

    .price-range {
      font-size: 0.86rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #1a3a5c;
      white-space: nowrap;
    }

    .service p {
      margin: 0;
      color: #5a6a7a;
      font-size: 0.9rem;
    }

    .service-body {
      padding: 0 1rem 1rem;
    }

    .service-body ul {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid #d0dce8;
    }

    .service-body li {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.8rem 0;
      border-bottom: 1px solid #d0dce8;
      font-size: 0.92rem;
    }

    .service-body li:last-child { border-bottom: 0; }

    .service-book {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 44px;
      margin-top: 0.9rem;
      border: 1px solid #1a3a5c;
      border-radius: 8px;
      background: transparent;
      color: #1a3a5c;
      cursor: pointer;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .section-booking {
      background: #0a0f17;
      color: #fff;
    }

    .section-booking .section-head h2 { color: #fff; }
    .section-booking .section-head small { color: rgba(255, 255, 255, 0.58); }
    .section-booking .rule { background: rgba(255, 255, 255, 0.24); }

    .booking-panel {
      max-width: 46rem;
      margin: 0 auto;
      padding: 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.04);
    }

    .booking-step { margin: 0 0 1rem; color: rgba(255, 255, 255, 0.58); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; }
    .booking-service { display: grid; gap: 0.35rem; margin: 0 0 1.25rem; }
    .booking-service__name { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; }
    .booking-service__price { color: rgba(255, 255, 255, 0.68); font-size: 0.9rem; }
    .booking-form { display: grid; gap: 1rem; }
    .booking-field { display: grid; gap: 0.4rem; }
    .booking-field label { font-size: 0.82rem; font-weight: 700; }
    .booking-field input { width: 100%; min-height: 50px; padding: 0.75rem 0.85rem; border: 1px solid rgba(255, 255, 255, 0.28); border-radius: 8px; background: #fff; color: #0d1b2a; font: inherit; }
    .booking-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.4rem; }
    .booking-button { min-height: 50px; padding: 0.8rem 1rem; border: 1px solid #fff; border-radius: 8px; background: #fff; color: #0d1b2a; cursor: pointer; font: inherit; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
    .booking-button--secondary { background: transparent; color: #fff; }
    .booking-button--whatsapp { border-color: #25d366; background: #25d366; color: #fff; }
    .booking-note, .booking-error { margin: 1rem 0 0; font-size: 0.9rem; }
    .booking-note { color: rgba(255, 255, 255, 0.7); }
    .booking-error { color: #ffb6c6; }
    .booking-loading { margin: 1.25rem 0 0; color: rgba(255, 255, 255, 0.72); font-size: 0.9rem; }
    .cal-scheduler { min-height: 390px; margin-top: 1rem; overflow: hidden; border-radius: 8px; background: #fff; }
    .booking-success { text-align: center; }
    .booking-success-logo { width: min(42vw, 112px); margin: 0 auto 1.1rem; }
    .booking-success-mark { display: grid; width: 2.4rem; height: 2.4rem; margin: 0 auto 1rem; place-items: center; border-radius: 50%; background: #25d366; color: #fff; font-size: 1.35rem; font-weight: 700; line-height: 1; }
    .booking-success h3 { margin: 0 0 0.75rem; font-family: var(--font-display); font-size: clamp(2rem, 8vw, 2.7rem); line-height: 1.1; }
    .booking-success p { margin: 0 0 1.25rem; color: rgba(255, 255, 255, 0.74); }
    .booking-summary { display: grid; gap: 0.7rem; margin: 0 auto 1.5rem; padding: 1rem; border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 8px; text-align: left; }
    .booking-summary div { display: flex; justify-content: space-between; gap: 1rem; }
    .booking-summary small { color: rgba(255, 255, 255, 0.56); text-transform: uppercase; letter-spacing: 0.1em; }
    .booking-summary strong { text-align: right; }
    [hidden] { display: none !important; }
    button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid rgba(154, 31, 61, 0.72); outline-offset: 3px; }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .gallery-cell {
      aspect-ratio: 1;
      border: 1px solid #d0dce8;
      border-radius: 10px;
      overflow: hidden;
      background: #e8edf2;
    }

    .gallery-trigger {
      display: block;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .gallery-cell img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 180ms ease;
    }

    .gallery-trigger:hover img,
    .gallery-trigger:focus-visible img {
      transform: scale(1.03);
    }

    .gallery-trigger:focus-visible {
      outline: 3px solid rgba(26, 58, 92, 0.35);
      outline-offset: -3px;
    }

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: grid;
      place-items: center;
      padding: 1rem;
      background: rgba(0, 0, 0, 0.82);
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }

    .lightbox.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-dialog {
      position: relative;
      width: min(100%, 64rem);
      max-height: min(100dvh - 2rem, 56rem);
      display: grid;
      gap: 0.75rem;
    }

    .lightbox-close {
      position: absolute;
      top: 0.4rem;
      right: 0.4rem;
      z-index: 1;
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.62);
      color: #fff;
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
    }

    .lightbox-frame {
      overflow: hidden;
      border-radius: 14px;
      background: #0a0f17;
      box-shadow: 0 18px 70px rgba(0, 0, 0, 0.35);
    }

    .lightbox-frame img {
      display: block;
      width: 100%;
      max-height: min(100dvh - 2rem, 56rem);
      object-fit: contain;
      background: #0a0f17;
    }

    .lightbox-caption {
      margin: 0;
      text-align: center;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.82rem;
      letter-spacing: 0.08em;
    }

    .hours-table {
      width: 100%;
      border-collapse: collapse;
    }

    .hours-table tr {
      border-bottom: 1px solid #d0dce8;
    }

    .hours-table td {
      padding: 0.85rem 0;
      font-size: 0.94rem;
    }

    .hours-table td:first-child {
      color: #5a6a7a;
    }

    .hours-table td:last-child {
      text-align: right;
      color: #1a1a2e;
      font-weight: 500;
    }

    .contact-grid {
      display: grid;
      gap: 1.5rem;
    }

    .contact-stack {
      display: grid;
      gap: 1rem;
    }

    .contact-item {
      display: grid;
      gap: 0.3rem;
    }

    .contact-item small {
      font-size: 0.72rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: #5a6a7a;
    }

    .contact-item strong,
    .contact-item a,
    .contact-item span {
      color: #1a1a2e;
      font-size: 0.98rem;
      font-weight: 400;
    }

    .contact-actions {
      display: grid;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }

    .contact-actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      border-radius: 10px;
      font-size: 0.82rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .whatsapp {
      background: #25d366;
      color: #fff;
    }

    .instagram {
      border: 1px solid #d0dce8;
      color: #1a1a2e;
    }

    .map {
      width: 100%;
      min-height: 320px;
      border: 1px solid #d0dce8;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 16px rgba(13, 27, 42, 0.08);
    }

    .map iframe {
      width: 100%;
      height: 100%;
      min-height: 320px;
      border: 0;
      display: block;
    }

    .footer {
      background: #f4f7fa;
      color: #1a1a2e;
      text-align: center;
      padding: 2.75rem 1rem 2rem;
      border-top: 1px solid #d0dce8;
    }

    .footer img {
      width: 84px;
      margin: 0 auto 1rem;
    }

    .footer strong {
      display: block;
      margin-bottom: 0.4rem;
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 0.12em;
      color: #0d1b2a;
    }

    .footer p {
      margin: 0;
      color: #5a6a7a;
      font-size: 0.82rem;
    }

    @media (min-width: 700px) {
      .nav { padding-inline: 2rem; }
      .nav-link { padding-inline: 1.2rem; }
      .hero { background-size: auto; }
      .hero-card { padding: 2.5rem 2rem 2.7rem; }
      .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .gallery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .contact-grid { grid-template-columns: 0.9fr 1.1fr; align-items: start; }
      .contact-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .booking-panel { padding: 1.75rem; }
    }

    @media (min-width: 980px) {
      .services-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 699px) {
      .lightbox {
        padding: 0.75rem;
      }

      .lightbox-dialog {
        width: 100%;
        max-height: calc(100dvh - 1.5rem);
      }

      .lightbox-frame img {
        max-height: calc(100dvh - 1.5rem);
      }

      .booking-actions { display: grid; }
      .booking-button { width: 100%; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <nav class="nav">
      <a class="brand" href="#inicio" aria-label="Parthenon Barbearia">
        <img src="/logo.png" alt="Parthenon Barbearia" />
        <span class="brand-copy">
          <small>Barbearia</small>
          <strong>Parthenon</strong>
        </span>
      </a>
      <a class="nav-link" href="#agendar">Agendar horário</a>
    </nav>

    <section class="hero" id="inicio">
      <div class={`hero-card ${HERO_PANEL_ENABLED ? 'hero-card--panel' : 'hero-card--plain'}`}>
        <img class="hero-logo" src="/logo.png" alt="Parthenon Barbearia" />
        <p class="hero-quote">“Cuidar da aparência não é vaidade — é o respeito silencioso que um homem tem por si mesmo.”</p>
        <p class="hero-byline">{OWNER} · Parthenon Barbearia</p>
        <div class="hero-actions">
          <a class="cta" href="#agendar">Agendar horário</a>
          <a class="cta-secondary" href="#servicos">Ver serviços</a>
        </div>
      </div>
      <div class="scroll-note" aria-hidden="true">
        <span>Rolar</span>
        <span>↓</span>
      </div>
    </section>

    <section class="section-light" id="servicos">
      <div class="container">
        <div class="section-head">
          <small>O que oferecemos</small>
          <h2>Nossos serviços, sem esconder preço.</h2>
          <div class="rule"></div>
        </div>
        <div class="services-grid">
          {servicesByGroup.map(group => (
            <article class="service">
              <div class="service-head">
                <div class="service-top">
                  <h3>{group.name}</h3>
                  <span class="price-range">{group.range}</span>
                </div>
              </div>
              <div class="service-body">
                <ul>
                  {group.services.map(service => (
                    <li><span>{service.name}</span><strong>{service.price}</strong></li>
                  ))}
                </ul>
                {group.serviceIds.length === 1 ? (
                  <button class="service-book" type="button" data-booking-service={group.serviceIds[0]}>Agendar horário</button>
                ) : (
                  <button class="service-book" type="button" data-booking-group={group.serviceIds.join(',')}>Escolher serviço</button>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-booking" id="agendar" aria-labelledby="booking-heading">
      <div class="container">
        <div class="section-head">
          <small>Agendamento online</small>
          <h2 id="booking-heading">Escolha seu horário.</h2>
          <div class="rule"></div>
        </div>
        <div class="booking-panel" id="booking-panel">
          <div id="booking-selection">
            <p class="booking-step">1. Serviço</p>
            <p class="booking-note">Escolha um serviço acima para começar seu agendamento.</p>
          </div>
          <div id="booking-details" hidden>
            <p class="booking-step">2. Seus dados</p>
            <div class="booking-service">
              <span class="booking-service__name" id="booking-service-name"></span>
              <span class="booking-service__price" id="booking-service-price"></span>
            </div>
            <form class="booking-form" id="booking-form" novalidate>
              <div class="booking-field">
                <label for="booking-name">Nome</label>
                <input id="booking-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="booking-field">
                <label for="booking-phone">Telefone / WhatsApp</label>
                <input id="booking-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(34) 9 9999-9999" required />
              </div>
              <div class="booking-actions">
                <button class="booking-button" type="submit">Ver horários disponíveis</button>
                <button class="booking-button booking-button--secondary" type="button" data-booking-change>Trocar serviço</button>
              </div>
              <p class="booking-error" id="booking-form-error" role="alert" hidden></p>
            </form>
          </div>
          <div id="booking-unavailable" hidden>
            <p class="booking-step">Agendamento online</p>
            <div class="booking-service">
              <span class="booking-service__name" id="booking-unavailable-service"></span>
              <span class="booking-service__price" id="booking-unavailable-price"></span>
            </div>
            <p class="booking-note">Este serviço ainda não está disponível para agendamento online. Fale com Marco pelo WhatsApp para encontrar o melhor horário.</p>
            <div class="booking-actions">
              <a class="booking-button booking-button--whatsapp" id="booking-unavailable-whatsapp" target="_blank" rel="noopener">Chamar no WhatsApp</a>
              <button class="booking-button booking-button--secondary" type="button" data-booking-change>Trocar serviço</button>
            </div>
          </div>
          <div id="booking-calendar" hidden>
            <p class="booking-step">3. Data e horário</p>
            <div class="booking-service">
              <span class="booking-service__name" id="booking-calendar-service"></span>
              <span class="booking-service__price" id="booking-calendar-price"></span>
            </div>
            <p class="booking-loading" id="booking-calendar-loading" role="status">Carregando horários disponíveis...</p>
            <div class="cal-scheduler" id="cal-scheduler" aria-live="polite"></div>
            <p class="booking-error" id="booking-cal-error" role="alert" hidden></p>
            <div class="booking-actions">
              <button class="booking-button booking-button--secondary" type="button" data-booking-change>Trocar serviço</button>
            </div>
          </div>
          <div class="booking-success" id="booking-success" hidden aria-live="polite">
            <p class="booking-step">Agendamento confirmado</p>
            <img class="booking-success-logo" src="/logo.png" alt="Parthenon Barbearia" />
            <span class="booking-success-mark" aria-hidden="true">✓</span>
            <h3>Horário confirmado!</h3>
            <p id="booking-success-copy"></p>
            <div class="booking-summary">
              <div><small>Serviço</small><strong id="booking-success-service"></strong></div>
              <div><small>Data</small><strong id="booking-success-date"></strong></div>
              <div><small>Horário</small><strong id="booking-success-time"></strong></div>
            </div>
            <p>Seu horário já está confirmado. Para facilitar o contato com a barbearia, você pode enviar uma confirmação pelo WhatsApp. A mensagem já estará pronta. É só enviar.</p>
            <div class="booking-actions">
              <a class="booking-button booking-button--whatsapp" id="booking-whatsapp-confirmation" target="_blank" rel="noopener">Abrir WhatsApp</a>
              <a class="booking-button booking-button--secondary" id="booking-back-home" href="#inicio">Voltar ao início</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-white" id="galeria">
      <div class="container">
        <div class="section-head">
          <small>Nosso trabalho</small>
          <h2>Galeria</h2>
          <div class="rule"></div>
        </div>
        <div class="gallery-grid">
          {gallery.map((src, index) => (
            <div class="gallery-cell">
              <button
                class="gallery-trigger"
                type="button"
                data-gallery-trigger
                data-gallery-src={src}
                data-gallery-alt={`Trabalho ${index + 1} da Parthenon Barbearia`}>
                <img src={src} alt={`Trabalho ${index + 1} da Parthenon Barbearia`} loading="lazy" />
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-light" id="horarios">
      <div class="container">
        <div class="section-head">
          <small>Quando estamos abertos</small>
          <h2>Horários de funcionamento</h2>
          <div class="rule"></div>
        </div>
        <table class="hours-table">
          <tbody>
            {hours.map(h => (
              <tr><td>{h.day}</td><td>{h.value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-white" id="contato">
      <div class="container">
        <div class="section-head">
          <small>Fale conosco</small>
          <h2>Contato e localização</h2>
          <div class="rule"></div>
        </div>
        <div class="contact-grid">
          <div class="contact-stack">
            <div class="contact-item">
              <small>Barbeiro</small>
              <strong>{OWNER}</strong>
            </div>
            <div class="contact-item">
              <small>Endereço</small>
              <span>Rua da Fartura, 1767<br />Bairro Minas Gerais<br />Uberlândia – MG</span>
            </div>
            <div class="contact-item">
              <small>Telefone / WhatsApp</small>
              <a href={`tel:${WHATSAPP_URL.replace('https://wa.me/','')}`}>{WHATSAPP_TEL}</a>
            </div>
            <div class="contact-item">
              <small>E-mail</small>
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </div>
            <div class="contact-actions">
              <a class="whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener">Chamar no WhatsApp</a>
              <a class="instagram" href={INSTAGRAM_URL} target="_blank" rel="noopener">@parthenonbarbearia</a>
            </div>
          </div>
          <div class="map">
            <iframe
              src="https://maps.google.com/maps?q=Rua+da+Fartura,+1767,+Uberlândia,+MG,+Brasil&output=embed&hl=pt-BR"
              title="Localização da Parthenon Barbearia"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </section>

    <footer class="footer">
      <img src="/logo.png" alt="Parthenon Barbearia" />
      <strong>Parthenon Barbearia</strong>
      <p>&copy; 2025 Barbearia Parthenon — Uberlândia, MG</p>
    </footer>
  </div>

  <div class="lightbox" id="gallery-lightbox" aria-hidden="true">
    <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Imagem ampliada">
      <button class="lightbox-close" type="button" aria-label="Fechar imagem" data-lightbox-close>&times;</button>
      <div class="lightbox-frame">
        <img id="lightbox-image" src="" alt="" />
      </div>
      <p class="lightbox-caption" id="lightbox-caption"></p>
    </div>
  </div>

  <script id="booking-config" type="application/json" set:html={JSON.stringify({ services: bookingServices, whatsappUrl: WHATSAPP_URL })}></script>

  <script is:inline>
    const bookingConfig = JSON.parse(document.getElementById('booking-config')?.textContent || '{"services":[]}');
    const bookingServicesById = new Map(bookingConfig.services.map((service) => [service.id, service]));
    const bookingPanel = document.getElementById('booking-panel');
    const bookingSelection = document.getElementById('booking-selection');
    const bookingDetails = document.getElementById('booking-details');
    const bookingUnavailable = document.getElementById('booking-unavailable');
    const bookingCalendar = document.getElementById('booking-calendar');
    const bookingSuccess = document.getElementById('booking-success');
    const bookingForm = document.getElementById('booking-form');
    const bookingName = document.getElementById('booking-name');
    const bookingPhone = document.getElementById('booking-phone');
    const bookingFormError = document.getElementById('booking-form-error');
    const bookingCalError = document.getElementById('booking-cal-error');
    const bookingCalendarLoading = document.getElementById('booking-calendar-loading');
    const calendarHost = document.getElementById('cal-scheduler');
    let selectedBookingService = null;
    let calEmbedInitialized = false;

    const setBookingView = (view) => {
      [bookingSelection, bookingDetails, bookingUnavailable, bookingCalendar, bookingSuccess].forEach((element) => {
        element.hidden = element !== view;
      });
    };

    const scrollToBooking = () => {
      bookingPanel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const clearBookingErrors = () => {
      bookingFormError.hidden = true;
      bookingCalError.hidden = true;
    };

    const setBookingServiceText = (nameId, priceId, service) => {
      document.getElementById(nameId).textContent = service.name;
      document.getElementById(priceId).textContent = service.price;
    };

    const formatBrazilPhone = (value) => {
      let digits = value.replace(/\D/g, '');
      if ((digits.length === 12 || digits.length === 13) && digits.startsWith('55')) digits = digits.slice(2);
      if (digits.length <= 2) return digits ? `(${digits}` : '';
      if (digits.length <= 6) return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
      if (digits.length <= 10) return `(${digits.slice(0, 2)}) ${digits.slice(2, 6)}-${digits.slice(6)}`;
      return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7, 11)}`;
    };

    const normalizedBrazilPhone = (value) => {
      let digits = value.replace(/\D/g, '');
      if ((digits.length === 12 || digits.length === 13) && digits.startsWith('55')) digits = digits.slice(2);
      return digits.length === 10 || digits.length === 11 ? `+55${digits}` : null;
    };

    const dateParts = (dateString) => {
      const date = new Date(dateString);
      if (Number.isNaN(date.getTime())) return null;
      return {
        date: new Intl.DateTimeFormat('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Sao_Paulo' }).format(date),
        time: new Intl.DateTimeFormat('pt-BR', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Sao_Paulo' }).format(date),
      };
    };

    const calLinkValue = (calLink) => calLink.replace(/^https?:\/\/(?:app\.)?cal\.com\//, '').replace(/^\//, '').trim();

    const selectBookingService = (serviceId) => {
      const service = bookingServicesById.get(serviceId);
      if (!service) return;
      selectedBookingService = service;
      clearBookingErrors();
      bookingCalendarLoading.hidden = true;
      setBookingServiceText('booking-service-name', 'booking-service-price', service);
      setBookingServiceText('booking-calendar-service', 'booking-calendar-price', service);
      setBookingServiceText('booking-unavailable-service', 'booking-unavailable-price', service);
      document.getElementById('booking-unavailable-whatsapp').href = `${bookingConfig.whatsappUrl}?text=${encodeURIComponent(`Olá! Gostaria de agendar ${service.name} (${service.price}).`)}`;
      if (!service.bookable || !service.calLink) {
        setBookingView(bookingUnavailable);
      } else {
        setBookingView(bookingDetails);
        bookingName.focus();
      }
      scrollToBooking();
    };

    const showServiceChoices = (serviceIds) => {
      bookingSelection.replaceChildren();
      const step = document.createElement('p');
      step.className = 'booking-step';
      step.textContent = '1. Serviço';
      bookingSelection.append(step);
      const prompt = document.createElement('p');
      prompt.className = 'booking-note';
      prompt.textContent = 'Escolha o serviço que deseja agendar.';
      bookingSelection.append(prompt);
      const choices = document.createElement('div');
      choices.className = 'booking-actions';
      serviceIds.forEach((serviceId) => {
        const service = bookingServicesById.get(serviceId);
        if (!service) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'booking-button booking-button--secondary';
        button.textContent = `${service.name} - ${service.price}`;
        button.addEventListener('click', () => selectBookingService(service.id));
        choices.append(button);
      });
      bookingSelection.append(choices);
      setBookingView(bookingSelection);
      scrollToBooking();
    };

    const showInitialBookingSelection = (clearClientDetails = false) => {
      selectedBookingService = null;
      calendarHost.replaceChildren();
      bookingCalendarLoading.hidden = true;
      if (clearClientDetails) {
        bookingName.value = '';
        bookingPhone.value = '';
      }
      bookingSelection.innerHTML = '<p class="booking-step">1. Serviço</p><p class="booking-note">Escolha um serviço acima para começar seu agendamento.</p>';
      setBookingView(bookingSelection);
      clearBookingErrors();
    };

    const loadCalEmbed = () => {
      if (window.Cal) return Promise.resolve(window.Cal);
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://app.cal.com/embed/embed.js';
        script.async = true;
        script.onload = () => window.Cal ? resolve(window.Cal) : reject(new Error('Cal.com indisponível.'));
        script.onerror = () => reject(new Error('Não foi possível carregar o calendário.'));
        document.head.append(script);
      });
    };

    const showBookingSuccess = (booking) => {
      const selectedService = selectedBookingService;
      if (!selectedService) return;
      const parts = dateParts(booking.startTime);
      const name = bookingName.value.trim();
      const formattedDate = parts?.date || 'Data confirmada no Cal.com';
      const formattedTime = parts?.time || 'Horário confirmado no Cal.com';
      document.getElementById('booking-success-copy').textContent = `${name}, seu horário está confirmado.`;
      document.getElementById('booking-success-service').textContent = selectedService.name;
      document.getElementById('booking-success-date').textContent = formattedDate;
      document.getElementById('booking-success-time').textContent = formattedTime;
      const message = [
        'Olá! Acabei de fazer um agendamento pelo site da Parthenon.',
        '',
        `Nome: ${name}`,
        `Serviço: ${selectedService.name}`,
        `Data: ${formattedDate}`,
        `Horário: ${formattedTime}`,
        '',
        'Meu horário já foi confirmado pelo site. Se precisar falar comigo sobre o agendamento, pode usar este número.',
        booking.uid ? `\nCódigo do agendamento: ${booking.uid}` : '',
      ].filter(Boolean).join('\n');
      document.getElementById('booking-whatsapp-confirmation').href = `${bookingConfig.whatsappUrl}?text=${encodeURIComponent(message)}`;
      calendarHost.replaceChildren();
      setBookingView(bookingSuccess);
      scrollToBooking();
    };

    document.querySelectorAll('[data-booking-service]').forEach((button) => {
      button.addEventListener('click', () => selectBookingService(button.dataset.bookingService));
    });

    document.querySelectorAll('[data-booking-group]').forEach((button) => {
      button.addEventListener('click', () => showServiceChoices(button.dataset.bookingGroup.split(',')));
    });

    document.querySelectorAll('[data-booking-change]').forEach((button) => {
      button.addEventListener('click', showInitialBookingSelection);
    });

    document.getElementById('booking-back-home')?.addEventListener('click', () => {
      showInitialBookingSelection(true);
    });

    bookingPhone.addEventListener('input', () => {
      bookingPhone.value = formatBrazilPhone(bookingPhone.value);
    });

    bookingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearBookingErrors();
      const name = bookingName.value.trim();
      const phone = normalizedBrazilPhone(bookingPhone.value);
      if (!selectedBookingService || !selectedBookingService.calLink) return;
      if (name.length < 2) {
        bookingFormError.textContent = 'Informe seu nome para continuar.';
        bookingFormError.hidden = false;
        bookingName.focus();
        return;
      }
      if (!phone) {
        bookingFormError.textContent = 'Informe um telefone com DDD para continuar.';
        bookingFormError.hidden = false;
        bookingPhone.focus();
        return;
      }
      setBookingView(bookingCalendar);
      bookingCalendarLoading.hidden = false;
      scrollToBooking();
      try {
        const Cal = await loadCalEmbed();
        if (!calEmbedInitialized) {
          Cal('init', { origin: 'https://cal.com' });
          Cal('on', { action: 'bookingSuccessfulV2', callback: (event) => showBookingSuccess(event.detail?.data || {}) });
          Cal('on', { action: 'linkReady', callback: () => { bookingCalendarLoading.hidden = true; } });
          Cal('on', { action: 'linkFailed', callback: (event) => {
            console.warn('Falha ao carregar o embed do Cal.com.', event.detail?.data);
            bookingCalendarLoading.hidden = true;
            bookingCalError.textContent = 'Não foi possível abrir o calendário agora. Tente novamente ou fale com Marco pelo WhatsApp.';
            bookingCalError.hidden = false;
          }});
          calEmbedInitialized = true;
        }
        calendarHost.replaceChildren();
        Cal('inline', {
          elementOrSelector: calendarHost,
          calLink: calLinkValue(selectedBookingService.calLink),
          config: { name, attendeePhoneNumber: phone },
        });
      } catch (error) {
        bookingCalendarLoading.hidden = true;
        bookingCalError.textContent = 'Não foi possível abrir o calendário agora. Tente novamente ou fale com Marco pelo WhatsApp.';
        bookingCalError.hidden = false;
      }
    });

    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const triggers = document.querySelectorAll('[data-gallery-trigger]');
    const closeButton = document.querySelector('[data-lightbox-close]');

    const openLightbox = (src, alt) => {
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      lightboxCaption.textContent = alt;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImage.src = '';
      lightboxImage.alt = '';
      lightboxCaption.textContent = '';
      document.body.style.overflow = '';
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        openLightbox(trigger.dataset.gallerySrc, trigger.dataset.galleryAlt);
      });
    });

    closeButton?.addEventListener('click', closeLightbox);

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && lightbox?.classList.contains('is-open')) closeLightbox();
    });
  </script>

</body>
</html>
